# Copie este arquivo para .env e troque a senha.
# O .env está no .gitignore e nunca vai para o GitHub; este .env.example vai, sem valores reais.

# --- Banco (lido pelo docker-compose.yml e pelo código) ---
POSTGRES_USER=nvvs
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=nvvs
# 5433 no seu PC para não brigar com outro Postgres (ex.: o do L.I.L.A.S.) na 5432
POSTGRES_PORT=5433
# 127.0.0.1, não localhost: no Windows, localhost tenta o IPv6 primeiro e cada conexão demorava ~130 s
POSTGRES_HOST=127.0.0.1

# --- Coleta (RNF02: identificar o projeto nas requisições) ---
NVVS_USER_AGENT=nvvs.ai/0.1 (+https://github.com/SEU_USUARIO/nvvs-ai)

# --- Revisão independente pela Kimi (scripts/revisar_kimi.py, ADR-011) ---
# Chave criada em https://platform.kimi.ai/console/api-keys
MOONSHOT_API_KEY=
# Modelo usado em todos os portões (liste os disponíveis com --listar-modelos)
MOONSHOT_MODEL=kimi-k3.1-pro
